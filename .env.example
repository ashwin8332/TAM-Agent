# ============================================================
# TAM AI Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Configuration ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Supported models: qwen2.5 | gemma3 | mistral | llama3.2
MODEL=qwen2.5
EMBEDDING_MODEL=nomic-embed-text
MODEL_TEMPERATURE=0
MODEL_SEED=42

# ── Application ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# ── Data Paths (relative to project root) ─────────────────
DATA_DIR=./data
KB_DIR=./knowledge-base
FAISS_INDEX_PATH=./vector_store/faiss_index
PROMPTS_DIR=./prompts

# ── RAG Configuration ──────────────────────────────────────
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CONTEXT_LENGTH=3000

# ── Control ────────────────────────────────────────────────
MAX_RETRIES=3
REQUEST_TIMEOUT=120

# ── Evaluation ─────────────────────────────────────────────
EVAL_OUTPUT_DIR=./eval_results
